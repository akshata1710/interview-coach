    "("
   ],
   "expected": false
  },
  {
   "name": "single close",
   "category": "edge",
   "hidden": true,
   "args": [
    ")"
   ],
   "expected": false
  },
  {
   "name": "close first",
   "category": "edge",
   "hidden": true,
   "args": [
    "){}("
   ],
   "expected": false
  },
  {
   "name": "interleaved wrong",
   "category": "typical",
