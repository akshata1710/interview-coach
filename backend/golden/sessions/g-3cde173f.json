 "time_limit_s": 2700,
 "solve_time_s": 1080,
 "final_code": "def length_of_longest_substring(s):\n    last_seen = {}\n    left = best = 0\n    for right, ch in enumerate(s):\n        if ch in last_seen:\n            left = last_seen[ch] + 1\n        last_seen[ch] = right\n        best = max(best, right - left + 1)\n    return best\n",
